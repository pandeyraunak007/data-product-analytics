# Environment Variables for Data Product Analytics Platform

# For Vercel Deployment (PostgreSQL + Groq)
# -------------------------------------------------

# Groq API Key (FREE - get from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key

# PostgreSQL Database URL (from Supabase, Neon, or other provider)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# For Local Development
# -------------------------------------------------
# Leave these unset to use SQLite + Foundry Local
# The app will automatically detect and use local defaults
